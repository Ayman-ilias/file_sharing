# Southern IoT Files v2 — settings. Copy to /opt/southern-iot/file-sharing/.env with:
#   install -m 600 app/deploy/.env.example .env
# Only root may read it. Don't use a "$" in values (compose would expand it).

# REQUIRED: the starting password for every new account and the global account's password.
SHARED_PASSWORD=

# The one published port (the reverse proxy at 10.10.8.100 connects to it).
PUBLIC_PORT=5000
# Who may connect: space-separated IPs or CIDRs. Everyone else gets 403.
TRUSTED_PROXIES=10.10.8.100

# Launch day: the whole office registers from one IP. Set back to 10 after a week, then: sif.sh up
LOGIN_RATE_LIMIT=100

# Optional; the defaults are shown.
# ALLOWED_EMAIL_DOMAIN=southerniot.net
# GLOBAL_EMAIL=global@southerniot.net
# SESSION_DAYS=30
# ITEM_TTL_DAYS=30
# MAX_FILE_SIZE=10737418240
# MAX_TEXT_BYTES=1048576
# MAX_BATCH_FILES=5000
# DISK_MARGIN=2147483648
# VAULT_QUOTA=209715200

# Never change these in production:
# COOKIE_SECURE=true      (false only for plain-http testing)
# SERVE_FILES=false       (nginx sends file bytes)
# CHUNK_SIZE=16777216     (nginx accepts at most 20m per request)
